# Copiar a deploy/.env (scripts/generar-secretos.sh rellena los secretos).
# Sin dominio todavía: usar la IP del servidor, p. ej. http://192.168.1.50:3000
# y http://192.168.1.50:8000. Al pasar a dominio, cambiar las dos URL y
# reconstruir la app (docker compose up -d --build).

# ── URLs ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://IP-DEL-SERVIDOR:3000
NEXT_PUBLIC_SUPABASE_URL=http://IP-DEL-SERVIDOR:8000
APP_PORT=3000

# ── Supabase (copiar de supabase-project/.env) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Región (vacías = Argentina) ──────────────────────────────────────────────
# Zona horaria (America/Argentina/Buenos_Aires), formato (es-AR, 24 h) y
# moneda (ARS). Se graban al compilar: si cambian, reconstruir la app.
NEXT_PUBLIC_ZONA_HORARIA=
NEXT_PUBLIC_LOCALE=
NEXT_PUBLIC_MONEDA=

# ── Secretos internos (generar-secretos.sh) ──────────────────────────────────
CRON_SECRET=
# Mismo valor que el secreto 'supabase_cron_secret' de Vault (migrar.sh lo carga).
SUPABASE_CRON_SECRET=
OAUTH_STATE_SECRET=
HOME_PREVIEW_TOKEN_SECRET=
SUSTITUCION_TOKEN_SECRET=

# ── Inngest autoalojado (generar-secretos.sh) ────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Mercado Pago (cobro online) ──────────────────────────────────────────────
# Tus integraciones → la aplicación → Credenciales de producción: Access Token.
# Webhooks → URL https://TU-DOMINIO/api/mercadopago/webhook, evento «Pagos»,
# y la clave secreta que muestra. Con NEXT_PUBLIC_PASARELA=mercadopago la app
# de la alumna paga los recibos con Mercado Pago (se graba al compilar).
NEXT_PUBLIC_PASARELA=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Correo (Resend). Sin esto no salen correos de la app ─────────────────────
RESEND_API_KEY=
RESEND_FROM=

# ── Notificaciones push (generar-secretos.sh) ────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Apagados en esta instalación ─────────────────────────────────────────────
# Stripe (Mercado Pago lo reemplaza), Turnstile, Sentry, PostHog, R2, Cloudflare Stream, Google, Zoom,
# Klaviyo, Meta/WhatsApp, VeriFactu e IA quedan sin configurar.
ASISTENTE_IA=off

# Clave para cifrar en la app los secretos que se guardan en la base: la clave
# del certificado de ARCA (factura electrónica) y las credenciales de las
# integraciones. 32 bytes en base64; la genera generar-secretos.sh. Si se pierde,
# hay que volver a generar el certificado de ARCA.
INTEGRACIONES_CLAVE_CIFRADO=
