# Copiar a deploy/.env (scripts/generar-secretos.sh rellena los secretos).
# Sin dominio todavía: usar la IP del servidor, p. ej. http://192.168.1.50:3000
# y http://192.168.1.50:8000. Si cambian (otra IP, o pasar a dominio), cambiar
# las dos URL y `docker compose up -d`: se aplican al arrancar, sin compilar
# (o directamente deploy/scripts/cambiar-ip.sh).

# ── URLs ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://IP-DEL-SERVIDOR:3000
NEXT_PUBLIC_SUPABASE_URL=http://IP-DEL-SERVIDOR:8000
APP_PORT=3000

# ── Imagen de la app ─────────────────────────────────────────────────────────
# Vacía: el servidor compila la app (pide hasta 6 GB de memoria). Con la que
# compila GitHub, el servidor solo la descarga (`docker compose pull app`):
# APP_IMAGE=ghcr.io/eldoctormail/pilates-saas:latest
APP_IMAGE=

# ── Supabase (copiar de supabase-project/.env) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Región (vacías = Argentina) ──────────────────────────────────────────────
# Zona horaria (America/Argentina/Buenos_Aires), formato (es-AR, 24 h) y
# moneda (ARS). Se graban al compilar: si cambian, reconstruir la app.
NEXT_PUBLIC_ZONA_HORARIA=
NEXT_PUBLIC_LOCALE=
NEXT_PUBLIC_MONEDA=

# ── Secretos internos (generar-secretos.sh) ──────────────────────────────────
CRON_SECRET=
# Mismo valor que el secreto 'supabase_cron_secret' de Vault (migrar.sh lo carga).
SUPABASE_CRON_SECRET=
OAUTH_STATE_SECRET=
HOME_PREVIEW_TOKEN_SECRET=
SUSTITUCION_TOKEN_SECRET=

# ── Inngest autoalojado (generar-secretos.sh) ────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Mercado Pago (cobro online) ──────────────────────────────────────────────
# Lo normal es NO poner nada acá: la propietaria conecta su cuenta desde el
# panel (Apps e integraciones › Mercado Pago), y cada estudio cobra en la suya.
# Estas dos variables son para un estudio que no cargó la suya: Tus
# integraciones → la aplicación → Credenciales de producción (Access Token) y
# Webhooks (https://TU-DOMINIO/api/mercadopago/webhook, evento «Pagos», clave
# secreta).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Mensualidad de los estudios a Centra (Mercado Pago) ──────────────────────
# La cuenta de Mercado Pago de CENTRA, con la que cada estudio te paga su plan
# (no la de un estudio). Creá en Tus integraciones una aplicación aparte para
# esto («Suscripciones»): Credenciales de producción → Access Token, y Webhooks →
# https://TU-DOMINIO/api/billing/mercadopago/webhook con los eventos de «Planes y
# suscripciones», y copiá la clave secreta. Sin las dos, no se cobra a nadie.
MP_PLATAFORMA_ACCESS_TOKEN=
MP_PLATAFORMA_WEBHOOK_SECRET=
# Con «true», un estudio sin plan pagado (prueba terminada o baja vencida) no
# entra al panel hasta pagar. Sin poner, nadie queda afuera.
# BILLING_ENFORCED=true

# ── Correo de la app (invitaciones, avisos, constancias) ─────────────────────
# Sin esto no salen. Elegí UNA de las dos vías:
#
#  a) Resend, con tu dominio verificado en resend.com:
#       RESEND_API_KEY=re_...   y   RESEND_FROM=Tu Estudio <hola@tudominio.com.ar>
#
#  b) Cualquier SMTP (Gmail con contraseña de aplicación, el correo del estudio,
#     Mailpit para pruebas). La app sigue hablando «como Resend», pero contra su
#     propia pasarela (/api/correo-local), que reenvía por SMTP:
#       RESEND_API_KEY=local_ + 32 caracteres al azar (openssl rand -hex 16)
#       RESEND_BASE_URL=http://127.0.0.1:3000/api/correo-local
#       RESEND_FROM=Tu Estudio <tucuenta@gmail.com>   (Gmail exige su propia dirección)
#       SMTP_HOST=smtp.gmail.com
#       SMTP_PORT=465            (465 = TLS; 587 = STARTTLS; 1025 = Mailpit)
#       SMTP_USER=tucuenta@gmail.com
#       SMTP_PASS=la contraseña de aplicación (16 letras, sin espacios)
RESEND_API_KEY=
RESEND_FROM=
RESEND_BASE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Notificaciones push (generar-secretos.sh) ────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Apagados en esta instalación ─────────────────────────────────────────────
# Turnstile, Sentry, PostHog, R2, Cloudflare Stream, Google, Zoom, Klaviyo,
# Meta/WhatsApp e IA quedan sin configurar.
ASISTENTE_IA=off

# Clave para cifrar en la app los secretos que se guardan en la base: la clave
# del certificado de ARCA (factura electrónica) y las credenciales de las
# integraciones. 32 bytes en base64; la genera generar-secretos.sh. Si se pierde,
# hay que volver a generar el certificado de ARCA.
INTEGRACIONES_CLAVE_CIFRADO=

# ─── Producción (deploy/PRODUCCION.md) ───────────────────────────────────────
# El token del túnel de Cloudflare (Zero Trust › Networks › Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
# Copias de seguridad (deploy/scripts/copia.sh). Dónde, cuántas se guardan y,
# si se quiere una copia fuera, el remoto de rclone y la frase para cifrarlas.
COPIA_DESTINO=/var/backups/tentare
COPIA_CONSERVAR=14
COPIA_REMOTO=
COPIA_CLAVE=
